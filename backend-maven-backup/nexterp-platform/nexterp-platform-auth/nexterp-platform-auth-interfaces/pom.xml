<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nexterp</groupId>
        <artifactId>nexterp-platform-auth</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nexterp-platform-auth-interfaces</artifactId>

    <name>NextERP Platform Auth Interfaces</name>
    <description>NextERP 平台认证授权模块 - 接口层</description>

    <dependencies>
        <!-- Auth Application -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-platform-auth-application</artifactId>
        </dependency>

        <!-- Auth API (for DTOs) -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-platform-auth-api</artifactId>
        </dependency>

        <!-- Auth Infrastructure Core (for security configuration) -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-platform-auth-infrastructure-core</artifactId>
        </dependency>

        <!-- Auth Infrastructure Handlers (for authentication handlers) -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-platform-auth-infrastructure-handlers</artifactId>
        </dependency>

        <!-- Shared Core -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-shared-core</artifactId>
        </dependency>

        <!-- Shared Security -->
        <dependency>
            <groupId>com.nexterp</groupId>
            <artifactId>nexterp-shared-security</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Liquibase -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
