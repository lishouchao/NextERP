<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexterp</groupId>
    <artifactId>nexterp-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>NextERP BOM</name>
    <description>NextERP Bill of Materials - 统一依赖版本管理</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.version>1.0.0-SNAPSHOT</project.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Platform Layer (平台层) -->
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-platform-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-platform-tenant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-platform-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-platform-report</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-platform-notification</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Business Layer (业务层) -->
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-business-finance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-business-supply</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-business-sales</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-business-production</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-business-hrm</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Shared Layer (共享层) -->
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-shared-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-shared-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-shared-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- API Layer (API 网关) -->
            <dependency>
                <groupId>com.nexterp</groupId>
                <artifactId>nexterp-api-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
